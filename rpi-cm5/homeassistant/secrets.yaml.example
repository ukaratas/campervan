# /config/secrets.yaml olarak kopyalayın; gerçek değerleri girin.
# Karavan HAOS (onboard RS485): rs485_serial_port satırını yeni cihaza göre güncelleyin.
# Slave ID'ler Modbus cihaz adresleriyle aynı — tek yerden yönetim için burada tutulur.

# rs485_bus hub portu: IO8 DI/DO (slave 1) + Analog 8CH (slave 3).
# USB-RS485'ten onboard RS485 CH1'e taşındı (dtoverlay=uart3-pi5 → /dev/ttyAMA3).
# Eski USB yolu: /dev/serial/by-id/usb-1a86_USB_Single_Serial_5A98053502-if00
rs485_serial_port: /dev/ttyAMA3

# IPCBOX-CM5-A onboard RS485 CH0 (8'li Modbus röle). dtoverlay=uart2-pi5 → tipik /dev/ttyAMA2.
# config.txt'ye overlay eklendikten sonra `ls -l /dev/ttyAMA*` ile doğrulayıp gerçek yolu yazın.
rs485_ch0_port: /dev/ttyAMA2

# Waveshare Ethernet 16CH (RTU over TCP) — Teltonika LAN örneği
waveshare_ws01_host: 192.168.50.20
waveshare_ws01_port: 4196

# Slave ID’ler artık rs485_bus_devices/*.yaml içinde sabit (1 / 2 / 3).
# Eski kurulumda secrets.yaml’da kalan modbus_slave_* satırları zararsızdır (kullanılmıyor).
